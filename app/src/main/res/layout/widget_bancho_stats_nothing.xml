<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_nothing_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Nothing OS Header: Avatar, Monospace Handle, Red Status Dot, Refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Player avatar"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:text="BANCHO"
                    android:textColor="@color/widget_nothing_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_updated_at"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text="OSU.STATS"
                    android:textColor="@color/widget_nothing_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_friends_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_nothing_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/widget_friends_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_dot_red" />

                <TextView
                    android:id="@+id/widget_friends_online"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="0 ON"
                    android:textColor="@color/widget_nothing_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_refresh_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_widget_nothing_tile"
                android:contentDescription="Refresh stats"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_refresh"
                android:tint="@color/widget_nothing_icon" />
        </LinearLayout>

        <!-- Nothing OS 4-tile grid with dot-matrix monospace numerics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_nothing_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="GLOBAL"
                    android:textColor="@color/widget_nothing_text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_global_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_nothing_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_nothing_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/widget_country_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="LOCAL"
                    android:textColor="@color/widget_nothing_text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_country_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_nothing_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_nothing_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="PP"
                    android:textColor="@color/widget_nothing_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_nothing_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_nothing_tile"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="ACC"
                    android:textColor="@color/widget_nothing_text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_accuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="—%"
                    android:textColor="@color/widget_nothing_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
